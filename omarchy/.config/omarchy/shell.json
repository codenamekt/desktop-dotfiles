{
  "version": 1,
  "idle": {
    "screensaver": 1800,
    "lock": 3600
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "center": [
        {
          "id": "codenamekt.indicators",
          "items": [
            "ScreenRecording",
            "Reminder",
            "Dnd",
            "StayAwake"
          ]
        },
        {
          "id": "omarchy.clock",
          "format": "ddd d MMM h:mm AP",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "codenamekt.weather"
        },
        {
          "id": "codenamekt.system-update"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "robzolkos.github",
          "includeContributions": true,
          "linkBehavior": "Browser tab"
        },
        {
          "id": "quickshell.spotify"
        },
        {
          "id": "omamail"
        },
        {
          "id": "omarchy.agents",
          "providers": {
            "claude": {
              "enabled": true
            },
            "codex": {
              "enabled": true
            },
            "fireworks": {
              "enabled": true
            },
            "openrouter": {
              "enabled": true
            },
            "deepseek": {
              "enabled": true
            },
            "minimax": {
              "enabled": true
            },
            "antigravity": {
              "enabled": true
            }
          }
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "codenamekt.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    }
  },
  "plugins": [
    {
      "id": "session-restore"
    }
  ]
}
