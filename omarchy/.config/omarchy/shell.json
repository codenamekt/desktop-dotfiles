{
  "version": 1,
  "idle": {
    "screensaver": 1800,
    "lock": 3600
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.agents",
          "providers": {
            "claude": {
              "enabled": true
            },
            "codex": {
              "enabled": true
            },
            "fireworks": {
              "enabled": true
            },
            "openrouter": {
              "enabled": true
            },
            "deepseek": {
              "enabled": true
            },
            "minimax": {
              "enabled": true
            },
            "antigravity": {
              "enabled": true
            }
          }
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    }
  },
  "plugins": [
    {
      "id": "session-restore"
    }
  ]
}
