#!/bin/bash
# Re-apply the session-restore save-on-exit wiring to Omarchy's power scripts.
# `omarchy update` restores /usr/share/omarchy/bin to defaults, which undoes
# the insert; this hook reapplies it after every update (one pkexec approval).

PLUGIN_DIR="$HOME/.config/omarchy/plugins/session-restore"
WIRING="$PLUGIN_DIR/install-power-wiring.py"

[[ -x "$WIRING" ]] || exit 0

# Already wired after this update — nothing to do.
grep -q "# BEGIN session-restore save-on-exit" /usr/share/omarchy/bin/omarchy-system-logout 2>/dev/null && exit 0

if timeout 45 pkexec python3 "$WIRING"; then
  echo "session-restore: power wiring re-applied"
else
  echo "session-restore: power wiring NOT re-applied (run: sudo python3 $WIRING)" >&2
fi
